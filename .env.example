# LLM Provider Configuration
# Choose between Google Gemini (default, recommended) or OpenAI (legacy)
# Options: 'gemini' or 'openai'
# Default: gemini (73% cheaper than GPT-3.5, excellent quality)
# LLM_PROVIDER=gemini

# Google Gemini API Configuration (Default Provider)
# Get your free API key from: https://makersuite.google.com/app/apikey
# Free tier: 1,500 requests/day (Flash), 50 requests/day (Pro)
GEMINI_KEY=your-gemini-api-key-here

# Optional: Choose Gemini model (defaults shown)
# gemini-1.5-flash: Fast, cost-effective, excellent for most tasks (default)
# gemini-1.5-pro: More powerful, better for complex planning tasks
# GEMINI_MODEL=gemini-1.5-flash

# OpenAI API Configuration (Legacy Support)
# Only required when LLM_PROVIDER=openai
# Get your API key from: https://platform.openai.com/api-keys
# OPENAI_API_KEY=your-openai-api-key-here
# OPENAI_MODEL=gpt-3.5-turbo
# OPENAI_ORGANIZATION=your-org-id

# Embedding Provider Configuration
# Choose between HuggingFace (local, free) or OpenAI (requires API key)
# Options: 'hf', 'huggingface', or 'openai'
# Default: hf (HuggingFace - no API key required)
# EMBEDDING_PROVIDER=hf

# HuggingFace Model Configuration (when using HuggingFace embeddings)
# Default model: all-MiniLM-L6-v2 (fast, good quality, runs locally)
# Other options: sentence-transformers/all-mpnet-base-v2 (slower but better quality)
# HUGGINGFACE_MODEL_NAME=all-MiniLM-L6-v2

# Vector Database Settings
# CHROMA_PERSIST_DIRECTORY=./chroma_db
# CHROMA_COLLECTION_NAME=adastrea_docs
