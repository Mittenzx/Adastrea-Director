{
  "name": "adastrea-director",
  "displayName": "Adastrea Director",
  "description": "VS Code extension for Adastrea Director - AI-powered game development assistant for Unreal Engine",
  "version": "0.3.0",
  "publisher": "mittenzx",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "unreal engine",
    "game development",
    "ai assistant",
    "copilot",
    "adastrea"
  ],
  "activationEvents": [
    "onLanguage:cpp",
    "onLanguage:c",
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "chatParticipants": [
      {
        "id": "director.chat",
        "name": "director",
        "fullName": "Adastrea Director",
        "description": "AI-powered game development assistant for Unreal Engine with RAG-based knowledge",
        "isSticky": true,
        "commands": [
          {
            "name": "ask",
            "description": "Ask a question about Unreal Engine or your project"
          },
          {
            "name": "plan",
            "description": "Generate a development plan for a goal"
          },
          {
            "name": "analyze",
            "description": "Analyze a development goal or task"
          },
          {
            "name": "context",
            "description": "Get relevant context from Director's RAG system"
          },
          {
            "name": "help",
            "description": "Show available commands and usage examples"
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "director.connect",
        "title": "Director: Connect to Unreal Engine"
      },
      {
        "command": "director.disconnect",
        "title": "Director: Disconnect from Unreal Engine"
      },
      {
        "command": "director.askQuestion",
        "title": "Director: Ask Question"
      },
      {
        "command": "director.checkStatus",
        "title": "Director: Check Connection Status"
      },
      {
        "command": "director.toggleDebugMode",
        "title": "Director: Toggle Debug Mode"
      },
      {
        "command": "director.runDiagnostics",
        "title": "Director: Run Connection Diagnostics"
      },
      {
        "command": "director.generateAndApplyCode",
        "title": "Director: Generate and Apply Code"
      },
      {
        "command": "director.runTests",
        "title": "Director: Run Tests"
      },
      {
        "command": "director.reviewPendingChanges",
        "title": "Director: Review Pending Changes"
      },
      {
        "command": "director.viewApprovalHistory",
        "title": "Director: View Approval History"
      },
      {
        "command": "director.showFeedbackStats",
        "title": "Director: Show Feedback Statistics"
      },
      {
        "command": "director.setApprovalThreshold",
        "title": "Director: Set Auto-Approval Threshold"
      },
      {
        "command": "director.provideFeedback",
        "title": "Director: Provide Feedback"
      },
      {
        "command": "director.unreal.checkConnection",
