{
  "name": "adastrea-director",
  "displayName": "Adastrea Director",
  "description": "VS Code extension for Adastrea Director - AI-powered game development assistant for Unreal Engine",
  "version": "0.2.0",
  "publisher": "mittenzx",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "unreal engine",
    "game development",
    "ai assistant",
    "copilot",
    "adastrea"
  ],
  "activationEvents": [
    "onCommand:director.connect",
    "onCommand:director.disconnect",
    "onCommand:director.askQuestion",
    "onCommand:director.checkStatus",
    "onCommand:director.toggleDebugMode",
    "onCommand:director.runDiagnostics",
    "onCommand:director.generateAndApplyCode",
    "onCommand:director.runTests",
    "onCommand:director.reviewPendingChanges",
    "onCommand:director.viewApprovalHistory",
    "onCommand:director.showFeedbackStats",
    "onCommand:director.setApprovalThreshold",
    "onCommand:director.provideFeedback"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "director.connect",
        "title": "Director: Connect to Unreal Engine"
      },
      {
        "command": "director.disconnect",
        "title": "Director: Disconnect from Unreal Engine"
      },
      {
        "command": "director.askQuestion",
        "title": "Director: Ask Question"
      },
      {
        "command": "director.checkStatus",
        "title": "Director: Check Connection Status"
      },
      {
        "command": "director.toggleDebugMode",
        "title": "Director: Toggle Debug Mode"
      },
      {
        "command": "director.runDiagnostics",
        "title": "Director: Run Connection Diagnostics"
      },
      {
        "command": "director.generateAndApplyCode",
        "title": "Director: Generate and Apply Code"
      },
      {
        "command": "director.runTests",
        "title": "Director: Run Tests"
      },
      {
        "command": "director.reviewPendingChanges",
        "title": "Director: Review Pending Changes"
      },
      {
        "command": "director.viewApprovalHistory",
        "title": "Director: View Approval History"
      },
      {
        "command": "director.showFeedbackStats",
        "title": "Director: Show Feedback Statistics"
      },
      {
        "command": "director.setApprovalThreshold",
        "title": "Director: Set Auto-Approval Threshold"
      },
      {
        "command": "director.provideFeedback",
        "title": "Director: Provide Feedback"
      }
    ],
    "configuration": {
      "title": "Adastrea Director",
      "properties": {
        "director.ipc.host": {
          "type": "string",
          "default": "localhost",
          "description": "Host address for Director IPC server"
        },
        "director.ipc.port": {
          "type": "number",
          "default": 5555,
          "description": "Port for Director IPC server"
        },
        "director.autoConnect": {
          "type": "boolean",
          "default": false,
          "description": "Automatically connect to Director on extension activation"
        },
        "director.reconnectInterval": {
          "type": "number",
          "default": 5000,
          "description": "Reconnection interval in milliseconds"
        },
        "director.maxReconnectAttempts": {
          "type": "number",
          "default": 3,
          "description": "Maximum number of reconnection attempts"
        },
        "director.requestTimeout": {
          "type": "number",
          "default": 30000,
          "description": "Request timeout in milliseconds"
        },
        "director.debugMode": {
          "type": "boolean",
          "default": false,
          "description": "Enable debug mode with verbose logging and diagnostics"
        },
        "director.autoApprovalThreshold": {
          "type": "number",
          "default": 0.9,
          "minimum": 0,
          "maximum": 1,
          "description": "Auto-approval confidence threshold (0.0 - 1.0). Changes with confidence above this threshold will be applied automatically."
        },
        "director.autoRunTests": {
          "type": "boolean",
          "default": false,
          "description": "Automatically run tests after applying code changes"
        },
        "director.enableFeedbackCollection": {
          "type": "boolean",
          "default": true,
          "description": "Enable automatic feedback collection for continuous learning"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "test": "node ./out/test/runTest.js",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.x",
    "@types/vscode": "^1.80.0",
    "@vscode/test-electron": "^2.3.0",
    "@vscode/vsce": "^3.2.1",
    "typescript": "^5.3.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Mittenzx/Adastrea-Director.git"
  },
  "license": "SEE LICENSE IN LICENSE"
}
