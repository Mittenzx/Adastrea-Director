        "category": "Adastrea UE Network"
      },
      {
        "command": "director.unreal.listCommands",
        "title": "Adastrea: List Console Commands",
        "category": "Adastrea UE Console"
      },
      {
        "command": "director.unreal.listCVars",
        "title": "Adastrea: List Console Variables",
        "category": "Adastrea UE Console"
      },
      {
        "command": "director.unreal.dumpConsoleCommands",
        "title": "Adastrea: Dump Console Commands",
        "category": "Adastrea UE Console"
      }
    ],
    "configuration": {
      "title": "Adastrea Director",
      "properties": {
        "director.ipc.host": {
          "type": "string",
          "default": "localhost",
          "description": "Host address for Director IPC server"
        },
        "director.ipc.port": {
          "type": "number",
          "default": 5555,
          "description": "Port for Director IPC server"
        },
        "director.autoConnect": {
          "type": "boolean",
          "default": false,
          "description": "Automatically connect to Director on extension activation"
        },
        "director.reconnectInterval": {
          "type": "number",
          "default": 5000,
          "description": "Reconnection interval in milliseconds"
        },
        "director.maxReconnectAttempts": {
          "type": "number",
          "default": 3,
          "description": "Maximum number of reconnection attempts"
        },
        "director.requestTimeout": {
          "type": "number",
          "default": 30000,
          "description": "Request timeout in milliseconds"
        },
        "director.debugMode": {
          "type": "boolean",
          "default": false,
          "description": "Enable debug mode with verbose logging and diagnostics"
        },
        "director.autoApprovalThreshold": {
          "type": "number",
          "default": 0.9,
          "minimum": 0,
          "maximum": 1,
          "description": "Auto-approval confidence threshold (0.0 - 1.0). Changes with confidence above this threshold will be applied automatically."
        },
        "director.autoRunTests": {
          "type": "boolean",
          "default": false,
          "description": "Automatically run tests after applying code changes"
        },
        "director.enableFeedbackCollection": {
          "type": "boolean",
          "default": true,
          "description": "Enable automatic feedback collection for continuous learning"
        },
        "director.copilot.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable GitHub Copilot Chat integration (@director participant)"
        },
        "director.copilot.enableHoverContext": {
          "type": "boolean",
          "default": true,
          "description": "Show Director context on hover for Unreal Engine symbols"
        },
        "director.copilot.enableCodeActions": {
          "type": "boolean",
          "default": true,
          "description": "Enable Director code actions (Ask Director, Get Context)"
        },
        "director.remoteControl.host": {
          "type": "string",
          "default": "localhost",
          "description": "Host address for Unreal Engine Remote Control API"
        },
        "director.remoteControl.port": {
          "type": "number",
          "default": 30010,
          "description": "Port for Unreal Engine Remote Control API"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "test": "node ./out/test/runTest.js",
    "lint": "eslint src --ext ts",
    "package": "vsce package --out ./"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.x",
    "@types/vscode": "^1.80.0",
    "@vscode/test-electron": "^2.3.0",
    "@vscode/vsce": "^3.2.1",
    "typescript": "^5.3.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Mittenzx/Adastrea-Director.git"
  },
  "license": "SEE LICENSE IN LICENSE"
}
