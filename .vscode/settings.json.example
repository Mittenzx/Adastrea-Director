{
  "github.copilot.chat.experimental.mcpServers": {
    // This enables GitHub Copilot to use the Adastrea Director MCP server for Unreal Engine integration
    "adastrea-unreal": {
      "command": "python",
      "args": ["-m", "mcp_server.server"],
      // Replace /absolute/path/to/Adastrea-Director with your actual path, or use ${workspaceFolder} if this is your workspace root
      "cwd": "/absolute/path/to/Adastrea-Director"
    }
  }
}
